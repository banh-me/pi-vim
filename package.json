{
  "name": "pi-vim",
  "version": "0.1.0",
  "description": "Vim modal editing for the pi coding agent prompt: INSERT/NORMAL/REPLACE/VISUAL/V-LINE with operators, text objects, registers, undo/redo, dot-repeat, OS-clipboard mirror and configurable escape sequences.",
  "keywords": [
    "pi-package",
    "pi",
    "vim",
    "vim-mode",
    "modal-editor",
    "coding-agent"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banh-me/pi-vim.git"
  },
  "bugs": {
    "url": "https://github.com/banh-me/pi-vim/issues"
  },
  "homepage": "https://github.com/banh-me/pi-vim#readme",
  "files": [
    "extension/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "author": "banh-me",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}